<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle shadow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFDFDFDF" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
    <!-- Inner white circle -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFAFAFA" />
            <size android:width="52dp" android:height="52dp" />
        </shape>
    </item>
</layer-list>
